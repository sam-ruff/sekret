{
  "realm": "sekret-test",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "bruteForceProtected": false,
  "roles": {
    "realm": [
      { "name": "sekret-admin" },
      { "name": "sekret-user" }
    ]
  },
  "users": [
    {
      "username": "alice",
      "email": "alice@example.com",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Admin",
      "enabled": true,
      "realmRoles": ["sekret-admin", "sekret-user", "default-roles-sekret-test"],
      "credentials": [{ "type": "password", "value": "alice-password", "temporary": false }]
    },
    {
      "username": "bob",
      "email": "bob@example.com",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Developer",
      "enabled": true,
      "realmRoles": ["sekret-user", "default-roles-sekret-test"],
      "credentials": [{ "type": "password", "value": "bob-password", "temporary": false }]
    },
    {
      "username": "service-account-ci-runner",
      "enabled": true,
      "serviceAccountClientId": "ci-runner",
      "realmRoles": ["default-roles-sekret-test"]
    }
  ],
  "clients": [
    {
      "clientId": "sekret",
      "name": "sekret",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "sekret-test-client-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:18080/auth/callback", "http://127.0.0.1:18080/auth/callback"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:18080*##http://127.0.0.1:18080*"
      },
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.client.audience": "sekret", "id.token.claim": "true", "access.token.claim": "true" }
        },
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "ci-runner",
      "name": "CI runner service account",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "ci-runner-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "sekret audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "sekret", "id.token.claim": "false", "access.token.claim": "true" }
        }
      ]
    }
  ]
}
